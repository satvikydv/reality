# Copy to .env and fill in. Never commit .env.

# Meta Model API (Standard mode only; never use the -contributor model)
MODEL_API_KEY=
META_API_BASE=https://api.meta.ai/v1
SPARK_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
VOICE_MODEL=muse-voice-transcribe-1.0
VOICE_WS_URL=wss://api.meta.ai/v1/asr/realtime

# Reasoner selection: meta | glimmer_modal | spark_open_baseten
REASONER_BACKEND=meta

# Open-weight backends (M4). OpenAI-compatible endpoints.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Dev server (HTTPS mode)
HOST=0.0.0.0
PORT=8443

# Required whenever the server binds anything other than loopback (e.g. HTTPS mode on 0.0.0.0).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ACCESS_TOKEN=

# USB dev mode: plain HTTP on 127.0.0.1 only, reached via `adb reverse`. No token needed.
# PLAIN_HTTP=1
# PLAIN_HTTP_PORT=8000
